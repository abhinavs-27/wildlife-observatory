# Copy to .env and edit. Never commit .env.

# Shared secret between the edge and inference workers (generate: openssl rand -hex 24)
WORKER_TOKEN=change-me

# Where the camera is
CAMERA_TIMEZONE=America/New_York
COUNTRY=USA
ADMIN1_REGION=NJ

# Phone alerts via ntfy (free). Pick unguessable topics and subscribe in the ntfy app.
NTFY_URL=https://ntfy.sh
# Yours: every visit alert, problems, milestones and the weekly digest (with links).
NTFY_TOPIC=
# Family (optional): only the Monday digest and big milestones, self-contained (no links).
NTFY_FAMILY_TOPIC=
# Family milestone pushes need this much confidence, or your Confirm on the sighting.
FAMILY_MIN_SCORE=0.8
# Where you open the dashboard (over Tailscale), used for links in your own pushes.
DASHBOARD_URL=http://observatory:3000

# Camera location, for sunrise/sunset in insights. Never committed. Default: central NJ.
CAMERA_LAT=40.06
CAMERA_LON=-74.41
# Optional weather history from Open-Meteo (sends location rounded to ~1 km).
WEATHER_ENABLED=false

# Thresholds
ANIMAL_THRESHOLD=0.2
ALERT_THRESHOLD=0.5
PERSON_THRESHOLD=0.5
ENCOUNTER_GAP_S=120
DISK_FLOOR_PCT=95

# Disk cleanup (microSD-friendly). Rows are never deleted, only original files.
DISK_HIGH_PCT=85            # above this, old videos then old photos are cleaned up
RETENTION_EMPTY_DAYS=14     # empty captures (wind, rain) are deleted after this
RETENTION_PERSON_DAYS=30    # photos with only people in them
VIDEO_KEEP_DAYS=7           # under disk pressure, keep only the small animal frames of older clips
ANIMAL_MIN_DAYS=30          # animal photos younger than this are never cleaned up
# Alert if the camera sends nothing for this long (battery, Wi-Fi or FTP trouble).
CAMERA_SILENT_HOURS=36

# Bind address for edge (8000) and dashboard (3000). On the Pi use 0.0.0.0 so the LAN and
# Tailscale can reach it - and do NOT port-forward these on the router.
BIND_ADDR=127.0.0.1
DATA_PATH=./data

# Pi worker: "detect" (default) or "detect,classify" if benchmarks show it fits in 4 GB.
WORKER_KINDS=detect
TORCH_THREADS=3
WORKER_MEM_LIMIT=1800m

# FTP receiver (camera pushes uploads here). Password lives in secrets/ftp_password.txt.
FTP_USER=camera
FTP_PORT=2121
FTP_PASSIVE_PORTS=30000-30009
FTP_MASQUERADE_ADDRESS=

# Host ports (change if 8000/3000 are taken)
EDGE_PORT=8000
WEB_PORT=3000
